# Copy to .env and edit. The .env file is gitignored.
#
# Snowflake credentials for this component. Every key is required - there are
# no fallbacks in code, so a missing one fails loudly rather than connecting
# as somebody else.

AMARA_SNOWFLAKE_ACCOUNT='myorg-myaccount'
AMARA_SNOWFLAKE_USER='AMARA_LOADER'

# A programmatic access token, not a password. Generate one under the user's
# settings in Snowsight; the connection sets authenticator=PROGRAMMATIC_ACCESS_TOKEN.
AMARA_SNOWFLAKE_TOKEN=''

AMARA_SNOWFLAKE_WAREHOUSE='AMARA_WH'
AMARA_SNOWFLAKE_DATABASE='AMARA'

# Two schemas: the raw crawl JSON and the stitched parquets are staged and
# loaded separately. Both hold an AMARA_STAGE internal stage.
AMARA_SNOWFLAKE_RAW_SCHEMA='RAW'
AMARA_SNOWFLAKE_PROCESSED_SCHEMA='PROCESSED'
AMARA_SNOWFLAKE_ANALYTICAL_SCHEMA='ANALYTICAL'
