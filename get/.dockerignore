# The crawl data. Gigabytes, produced by a run and carried on a volume -
# never baked into an image.
data/

# Credentials. These arrive at run time, from Airflow or `docker run -e`.
# A .env in the build context would end up in a layer, where deleting it
# later does not remove it.
.env
.env.*

__pycache__/
*.py[cod]

# Not needed to run the stage.
Dockerfile
.dockerignore
README.md
CLAUDE.md
